# Entorno local: development. Render establece production automáticamente.
NODE_ENV=development
PORT=3001

# Orígenes del frontend separados por coma, sin barra final.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
TRUST_PROXY_HOPS=0
JSON_BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# SQL Server local o SQL Server remoto administrado desde Plesk.
DB_SERVER=localhost
DB_INSTANCE=
DB_DATABASE=RetroGarage
DB_USER=TU_USUARIO_SQL
DB_PASSWORD=TU_CONTRASENA_SQL
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONNECTION_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=30000
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_TIMEOUT_MS=30000

# Usa una clave aleatoria de al menos 32 caracteres y no la cambies después
# de guardar datos cifrados sin realizar antes una rotación de claves.
DATA_ENCRYPTION_KEY=CAMBIA_ESTA_CLAVE_POR_UNA_ALEATORIA_DE_32_CARACTERES

# Correo para recuperación de contraseña.
SMTP_HOST=TU_SERVIDOR_SMTP
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=TU_USUARIO_SMTP
SMTP_PASS=TU_CONTRASENA_SMTP
SMTP_FROM=Retro Garage <no-reply@tudominio.com>

# PayPal. Conserva sandbox hasta terminar las pruebas de aceptación.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=TU_CLIENT_ID_SANDBOX
PAYPAL_CLIENT_SECRET=TU_SECRET_SANDBOX
PAYPAL_CURRENCY=USD
PAYPAL_CRC_PER_USD=500
PAYPAL_RETURN_URL=http://localhost:8081/pagos/paypal-retorno
PAYPAL_CANCEL_URL=http://localhost:8081/pagos/paypal-retorno
# Solo para pruebas negativas. Debe permanecer vacío normalmente.
PAYPAL_SANDBOX_MOCK_ERROR=

# Tipo de cambio de Hacienda/BCCR usado como referencia en Tarjeta y SINPE.
TIPO_CAMBIO_RESPALDO_CRC_USD=500
TIPO_CAMBIO_API_URL=https://api.hacienda.go.cr/indicadores/tc
TIPO_CAMBIO_CACHE_MS=1800000
